# CI-fetched ReShade headers — created at build time by .github/workflows/build.yml
# from crosire/reshade at the pinned SHA recorded in VENDOR_LOCK.md. Never committed.
ext/

# CMake build output
build/

# CI download scratch (codeload tarball). The fetch step keeps downloads in
# the workspace rather than /tmp: MSYS path translation on Windows runners
# makes /tmp unreliable for curl/tar arguments.
_dl/

# PROCESSCONTEXT-AB: the standalone diagnostic's own build and CI scratch. It is
# a separate CMake project under tools/processcontext_ab/ and never contributes
# anything to the add-on's build.
build-pcab/
_pcab/
_bt/
_cfg.txt
PCAB_VARIANT.txt

# MGPU-AutoLab run outputs and the CI artifact cache. Both are generated by
# tools/autolab/ and are never sources.
results/
cache/

# Python bytecode from running AutoLab.
__pycache__/
*.pyc

